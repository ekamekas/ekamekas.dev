{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /*
  The blog's posts are loaded into this site (render = 'link') only so the
  landing page can list them. Hugo's default sitemap would happily advertise
  them under ekamekas.dev/, where nothing is served. Only the home page is a
  real URL here.
*/ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range where site.Pages "Kind" "home" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
  </url>
{{- end }}
</urlset>
